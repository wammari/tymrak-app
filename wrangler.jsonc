{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tymrak-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node cloudflare/build-assets.mjs" },
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": {
    "APP_ENV": "staging",
    "CLOUDFLARE_RELEASE_ENV": "staging",
    "SUPABASE_URL": "https://ctztwqcsizwkrqgpgrgg.supabase.co",
    "SUPABASE_EXPECTED_PROJECT_REF": "ctztwqcsizwkrqgpgrgg"
  }
}
